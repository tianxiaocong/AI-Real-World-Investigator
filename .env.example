# ===============================================
# AI Real-World Investigator Environment Variables
# ===============================================

# LLM Provider Configuration (gemini, openai, deepseek, mock)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
FAST_LLM_MODEL=gemini-1.5-flash
REASONING_LLM_MODEL=gemini-1.5-pro

# Alternative: OpenAI / DeepSeek
# DEFAULT_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Search Provider Configuration (duckduckgo, tavily, mock)
DEFAULT_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration
# Default: Local SQLite (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./investigator.db
# PostgreSQL + pgvector alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investigator

# Scraper & Budget Limits
SCRAPER_TIMEOUT_SECONDS=15
MAX_SEARCH_QUERIES_PER_INVESTIGATION=5
MAX_SOURCES_PER_INVESTIGATION=12
INVESTIGATION_TIMEOUT_SECONDS=300
